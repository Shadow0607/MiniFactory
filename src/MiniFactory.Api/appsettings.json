{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System": "Warning"
      }
    }
  },
  "Idempotency": {
    "RetentionHours": 24
  }
}
