<Project>

  <!-- Central Package Management：所有套件版本只在此處定義 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- 測試：.NET 10 SDK 的 dotnet test 使用 Microsoft.Testing.Platform（見 global.json），
       不再支援 VSTest 的 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio / coverlet.collector。
       斷言使用 xUnit 內建 Assert，不引入 FluentAssertions。 -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.16.0" />
    <!-- WebApplicationFactory：API 整合測試（版本對齊 net10.0 共用框架） -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

  <!-- 資料存取（ADR-017、ADR-018）：Dapper + MySqlConnector + DbUp。不引入 EF Core。
       dbup-mysql 6.x 底層驅動為 MySqlConnector（5.x 以前綁 MySql.Data），所以可與 Dapper 共用同一個驅動。 -->
  <ItemGroup>
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="dbup-mysql" Version="6.1.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions.*：只用抽象（logging / DI），版本對齊 net10.0 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <!-- 結構化日誌（architecture.md §14.3）：Serilog → Console，Compact JSON -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
